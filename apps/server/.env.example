# Never commit the actual .env file.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kozel
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Explicit IDs of existing trusted accounts, not usernames. Empty means no admin.
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3005
# Local development only; use verified TLS in production (default).
DB_TLS=disable
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
